    "office-addin-debugging": "^5.0.0",
    "office-addin-manifest": "^1.12.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveDiamond/cvx-excel.git"
